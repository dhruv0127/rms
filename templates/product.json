{
  "sections": {
    "main": {
      "type": "product",
      "blocks": {
        "text_BifrBT": {
          "type": "text",
          "settings": {
            "title": "<h2>{{ product.title }}</h2>",
            "text_alignment": "left",
            "padding_bottom": 0
          }
        },
        "text_tKXqFk": {
          "type": "text",
          "settings": {
            "title": "<h5>{{ product.metafields.custom.product_trio_description.value }}</h5>",
            "text_alignment": "left",
            "padding_bottom": 8
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "enable_full_width": false,
            "padding_bottom": 6
          }
        },
        "form": {
          "type": "form",
          "settings": {
            "show_labels": false,
            "show_quantity": false,
            "show_payment_button": true,
            "enable_subscriptions_selectors": false,
            "padding_bottom": 20
          }
        },
        "product_accordion_notes": {
          "type": "product_accordion",
          "settings": {
            "show_description": false,
            "show_read_more": true,
            "enable_full_width": false,
            "tabs_bg_color": "",
            "text_color": "text-dark",
            "show_accordion_divider": true,
            "line_thickness": "normal",
            "accordion_heading": "fragrance notes",
            "heading_style": "font-body",
            "accordion_text": "<p>{{ product.metafields.custom.fragrance_nerd_notes | metafield_tag }}</p>",
            "accordion_page": "",
            "padding_bottom": 0
          }
        },
        "product_accordion_wear": {
          "type": "product_accordion",
          "settings": {
            "show_description": false,
            "show_read_more": true,
            "enable_full_width": false,
            "tabs_bg_color": "",
            "text_color": "text-dark",
            "show_accordion_divider": true,
            "line_thickness": "normal",
            "accordion_heading": "how to wear",
            "heading_style": "font-body",
            "accordion_text": "<p>{{ product.metafields.custom.how_to_wear | metafield_tag }}</p>",
            "accordion_page": "",
            "padding_bottom": 0
          }
        },
        "product_accordion_ingredients": {
          "type": "product_accordion",
          "settings": {
            "show_description": false,
            "show_read_more": true,
            "enable_full_width": false,
            "tabs_bg_color": "",
            "text_color": "text-dark",
            "show_accordion_divider": true,
            "line_thickness": "normal",
            "accordion_heading": "full ingredient list",
            "heading_style": "font-body",
            "accordion_text": "<p>{{ product.metafields.custom.pdp_full_ingredient_list | metafield_tag }}</p>",
            "accordion_page": "",
            "padding_bottom": 0
          }
        }
      },
      "block_order": [
        "text_BifrBT",
        "text_tKXqFk",
        "description",
        "form",
        "product_accordion_notes",
        "product_accordion_wear",
        "product_accordion_ingredients"
      ],
      "settings": {
        "product_sticky_enable": true,
        "image_layout": "grid",
        "image_width": "large",
        "product_image_aspect_ratio": true,
        "enable_zoom": false,
        "enable_video_looping": false,
        "bg_color": "",
        "gradient": "",
        "width": "wrapper",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "idiom-layering-row": {
      "type": "idiom-layering-row",
      "settings": {
        "heading": "layer it up",
        "subtext": "these scents were made to mix.",
        "cta_label": "shop all",
        "cta_url": "shopify://collections/all"
      }
    },
    "idiom-video-grid": {
      "type": "idiom-video-grid",
      "settings": {
        "descriptor": "real people. real scents.",
        "subtext": "see how the community wears idiom."
      }
    }
  },
  "order": ["main", "idiom-layering-row", "idiom-video-grid"]
}
