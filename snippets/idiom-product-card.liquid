{%- unless idiom_product_card_styles_rendered -%}
  {%- assign idiom_product_card_styles_rendered = true -%}
<style>
.idiom-product-card-link { text-decoration: none; color: inherit; display: block; }
.idiom-product-card-wrap { display: flex; flex-direction: column; }

/* Outer card: overflow visible so bottle can spill out the top */
.idiom-product-card {
  position: relative;
  overflow: visible;
  border-radius: 16px;
  aspect-ratio: 3 / 4;
}

/* Inner clipping layer: clips background image to rounded card shape */
.idiom-product-card__inner {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  overflow: hidden;
}

.idiom-product-card__bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Bottle overflows above card top */
.idiom-product-card__bottle {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: auto;
  height: 90%;
  object-fit: contain;
  z-index: 2;
  pointer-events: none;
}

.idiom-product-card__info { padding: 24px 4px 8px; }
.idiom-product-card__title { font-size: 16px; font-weight: 700; margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.04em; }
.idiom-product-card__scent { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.6; margin: 0 0 4px; }
.idiom-product-card__price { font-size: 14px; margin: 0; }

@media (max-width: 480px) {
  .idiom-product-card__title { font-size: 16px; }
  .idiom-product-card__scent,
  .idiom-product-card__price { font-size: 12px; }
}
</style>
{%- endunless -%}

<a href="{{ product.url }}" class="idiom-product-card-link">
  <div class="idiom-product-card-wrap">
    <div class="idiom-product-card">
      <div class="idiom-product-card__inner">
        {%- if override_image != blank -%}
          <img src="{{ override_image | image_url: width: 800 }}"
               alt="{{ product.title }}" class="idiom-product-card__bg" loading="lazy">
        {%- elsif product.metafields.custom.card_background_image != blank -%}
          <img src="{{ product.metafields.custom.card_background_image | image_url: width: 600 }}"
               alt="{{ product.title }}" class="idiom-product-card__bg" loading="lazy">
        {%- elsif product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}"
               alt="{{ product.title }}" class="idiom-product-card__bg" loading="lazy">
        {%- endif -%}
      </div>

      {%- if override_image == blank and product.metafields.custom.card_background_image != blank and product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 400 }}"
             alt="{{ product.title }}" class="idiom-product-card__bottle" loading="lazy">
      {%- endif -%}

      {%- if product.metafields.custom.personality_tag != blank -%}
        <span class="idiom-tag">{{ product.metafields.custom.personality_tag }}</span>
      {%- endif -%}
    </div>

    <div class="idiom-product-card__info">
      <p class="idiom-product-card__title">{{ product.title }}</p>
      {%- if product.metafields.custom.scent_descriptor != blank -%}
        <p class="idiom-product-card__scent">{{ product.metafields.custom.scent_descriptor }}</p>
      {%- endif -%}
      <p class="idiom-product-card__price">{{ product.price | money }}</p>
    </div>
  </div>
</a>
