{%- comment -%}
  idiom — site-wide "grab 10% off" offer tab.

  A fixed, rotated cream tab pinned to the bottom-left of the viewport on every
  page. Clicking it opens a centered discount popup with the newsletter signup
  form. All copy is editable via Theme settings → "Offer tab".

  Rendered once from layout/theme.liquid.
{%- endcomment -%}

{%- if settings.offer_tab_enable and settings.offer_tab_text != blank -%}
  {%- style -%}
    /* Wrapper pinned to the bottom-left edge of the viewport. */
    .idiom-offer-tab {
      position: fixed;
      left: 0;
      bottom: 10%;
      z-index: 60;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 40px;
      padding: 28px 0 28px;
      border: 0;
      cursor: pointer;
      background: #fbf6e9;
      /* big sweeping curve top-right, gentle round bottom-right; flush to left */
      border-radius: 0 50px 50px 0;
      box-shadow: 0 4px 18px rgba(26, 26, 26, 0.16);
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .idiom-offer-tab.is-dismissed {
      display: none;
    }
    .idiom-offer-tab:hover {
      box-shadow: 0 6px 22px rgba(26, 26, 26, 0.22);
    }
    .idiom-offer-tab__open {
      border: 0;
      background: transparent;
      padding: 0;
      cursor: pointer;
      display: flex;
      justify-content: center;
    }
    .idiom-offer-tab__text {
      writing-mode: vertical-rl;
      font-size: 16px;
      font-weight: 400;
      letter-spacing: 0.01em;
      color: var(--idiom-black, #1a1a1a);
      white-space: nowrap;
      line-height: 1;
    }
    .idiom-offer-tab__close {
      margin-top: 26px;
      width: 12px;
      height: 12px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 50%;
      background: #9a9a35;
      color: #fff;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      transition: background 0.2s ease;
      position: fixed;
      bottom: 10%;
      left: 20px;
      font-weight: 100;
      font-family: 'Space Mono';
      line-height: 0;
    }
    .idiom-offer-tab__close:hover {
      background: var(--idiom-olive-dark, #3d3d1a);
    }

    /* Popup */
    .idiom-offer-popup {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .idiom-offer-popup.is-open {
      display: flex;
    }
    .idiom-offer-popup__overlay {
      position: absolute;
      inset: 0;
      background: rgba(26, 26, 26, 0.55);
    }
    .idiom-offer-popup__panel {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 440px;
      background: var(--idiom-cream, #fffbf3);
      border-radius: 14px;
      padding: 40px 36px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(26, 26, 26, 0.3);
    }
    .idiom-offer-popup__close {
      position: absolute;
      top: 14px;
      right: 16px;
      width: 32px;
      height: 32px;
      border: 0;
      background: transparent;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
      color: var(--idiom-black, #1a1a1a);
    }
    .idiom-offer-popup__heading {
      margin: 0 0 10px;
      font-size: 28px;
      color: var(--idiom-black, #1a1a1a);
    }
    .idiom-offer-popup__text {
      margin: 0 0 20px;
      font-size: 15px;
      color: var(--idiom-black, #1a1a1a);
    }
    .idiom-offer-popup__text p { margin: 0; }
    .idiom-offer-popup__footer {
      margin: 16px 0 0;
      font-size: 12px;
      opacity: 0.7;
    }
    .idiom-offer-popup__footer p { margin: 0; }

    @media only screen and (max-width: 767px) {
      .idiom-offer-tab {
        width: 36px;
        padding: 24px 0 24px;
        border-radius: 0 50px 50px 0;
      }
      .idiom-offer-tab__text { font-size: 16px; }
      .idiom-offer-tab__close {
        width: 12px;
        height: 12px;
        font-size: 19px;
        margin-top: 16px;
      }
      .idiom-offer-popup__panel { padding: 36px 24px; }
      .idiom-offer-popup__heading { font-size: 24px; }
    }
  {%- endstyle -%}

  <div class="idiom-offer-tab" data-offer-tab>
    <button type="button" class="idiom-offer-tab__open" data-offer-open aria-haspopup="dialog" aria-controls="idiom-offer-popup">
      <span class="idiom-offer-tab__text">{{ settings.offer_tab_text }}</span>
    </button>
    <button type="button" class="idiom-offer-tab__close" data-offer-dismiss aria-label="Dismiss offer">&times;</button>
  </div>

  <div class="idiom-offer-popup" id="idiom-offer-popup" data-offer-popup role="dialog" aria-modal="true" aria-label="{{ settings.offer_tab_popup_heading | default: settings.offer_tab_text | escape }}">
    <div class="idiom-offer-popup__overlay" data-offer-close></div>
    <div class="idiom-offer-popup__panel">
      <button type="button" class="idiom-offer-popup__close" data-offer-close aria-label="Close">&times;</button>

      {%- if settings.offer_tab_popup_heading != blank -%}
        <h2 class="idiom-offer-popup__heading">{{ settings.offer_tab_popup_heading }}</h2>
      {%- endif -%}

      {%- if settings.offer_tab_popup_text != blank -%}
        <div class="idiom-offer-popup__text">{{ settings.offer_tab_popup_text }}</div>
      {%- endif -%}

      {%- render 'newsletter-form', unique: 'offer-tab', extra_fields: 'none', button_text: settings.offer_tab_button_text -%}

      {%- if settings.offer_tab_footer_text != blank -%}
        <div class="idiom-offer-popup__footer">{{ settings.offer_tab_footer_text }}</div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      var tab = document.querySelector('[data-offer-tab]');
      var popup = document.querySelector('[data-offer-popup]');
      if (!tab || !popup) return;

      var DISMISS_KEY = 'idiomOfferDismissed';
      try {
        if (sessionStorage.getItem(DISMISS_KEY) === '1') {
          // tab.classList.add('is-dismissed');
        }
      } catch (e) {}

      function open() {
        popup.classList.add('is-open');
        document.documentElement.style.overflow = 'hidden';
        var input = popup.querySelector('input[type="email"]');
        if (input) { try { input.focus(); } catch (e) {} }
      }
      function close() {
        popup.classList.remove('is-open');
        document.documentElement.style.overflow = '';
      }
      function dismiss() {
        tab.classList.add('is-dismissed');
        try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch (e) {}
      }

      tab.querySelector('[data-offer-open]').addEventListener('click', open);
      tab.querySelector('[data-offer-dismiss]').addEventListener('click', function (e) {
        e.stopPropagation();
        dismiss();
      });
      popup.querySelectorAll('[data-offer-close]').forEach(function (el) {
        el.addEventListener('click', close);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && popup.classList.contains('is-open')) close();
      });
    })();
  </script>
{%- endif -%}
