<style>
  .idiom-dual-promo { display: flex; width: 100%; }
  .idiom-dual-promo__panel { flex: 1 1 50%; position: relative; overflow: hidden; height: 480px; }
  .idiom-dual-promo__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .idiom-dual-promo__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.2); z-index: 1; }
  .idiom-dual-promo__content { position: absolute; bottom: 28px; left: 28px; z-index: 2; }
  .idiom-dual-promo__heading { color: #fff; font-size: 32px; font-weight: 700; margin: 0 0 8px; }
  .idiom-dual-promo__subtext { color: #fff; font-size: 13px; margin: 0 0 12px; }
  .idiom-dual-promo__cta { color: #fff; font-size: 13px; text-decoration: none; }
  .idiom-dual-promo__cta:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .idiom-dual-promo { flex-direction: column; }
    .idiom-dual-promo__panel { height: 280px; }
  }
</style>

<section class="idiom-dual-promo">
  {%- for block in section.blocks -%}
    <div class="idiom-dual-promo__panel" {{ block.shopify_attributes }}>
      {%- if block.settings.bg_image != blank -%}
        <img src="{{ block.settings.bg_image | image_url: width: 1000 }}"
             alt="{{ block.settings.heading }}" class="idiom-dual-promo__bg" loading="lazy">
      {%- endif -%}
      <div class="idiom-dual-promo__overlay"></div>
      <div class="idiom-dual-promo__content">
        {%- if block.settings.heading != blank -%}
          <h3 class="idiom-dual-promo__heading">{{ block.settings.heading }}</h3>
        {%- endif -%}
        {%- if block.settings.subtext != blank -%}
          <p class="idiom-dual-promo__subtext">{{ block.settings.subtext }}</p>
        {%- endif -%}
        {%- if block.settings.cta_label != blank -%}
          <a href="{{ block.settings.cta_url }}" class="idiom-dual-promo__cta">{{ block.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Dual Promo Banners",
  "blocks": [
    {
      "type": "panel",
      "name": "Promo panel",
      "settings": [
        { "type": "image_picker", "id": "bg_image", "label": "Background image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subtext", "label": "Subtext" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "shop now | £17" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    }
  ],
  "max_blocks": 2,
  "settings": [],
  "presets": [{ "name": "Dual Promo Banners" }]
}
{% endschema %}
