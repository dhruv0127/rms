<!-- /sections/footer.liquid -->

<style>
  .idiom-footer {
    background: var(--idiom-cream, #faf6f0);
    position: relative;
    overflow: hidden;
    padding: 48px 48px 0;
  }

  /* Combined logotype + collage image — full width, bleeds edge to edge */
  .idiom-footer__logotype-img {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    height: auto;
    position: absolute;
    z-index: 1;
    top: 0;
}

  /* Three text columns */
  .idiom-footer__columns {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 0;
    position: relative;
    z-index: 1;
    padding-bottom: 32px;
  }

  /* Col 1 spans 2 cols (brand + social), col 2 and 3 are links */
  .idiom-footer__col--brand {
    grid-column: span 1;
    padding-right: 40px;
  }

  .idiom-footer__col-heading {
    color: var(--idiom-black, #1a1a1a);
    font-weight: 700;
    margin: 0 0 12px;
  }

  .idiom-footer__col-heading--lg { font-size: 22px; }
  .idiom-footer__col-heading--sm { font-size: 15px; }

  .idiom-footer__tagline {
    color: rgba(26,26,26,0.7);
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 16px;
    max-width: 280px;
  }

  .idiom-footer__social {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .idiom-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid rgba(26,26,26,0.25);
    color: var(--idiom-black, #1a1a1a);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .idiom-footer__social-link:hover {
    border-color: var(--idiom-black, #1a1a1a);
    background: var(--idiom-black, #1a1a1a);
    color: #fff;
  }

  .idiom-footer__social-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .idiom-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .idiom-footer__links li { margin-bottom: 9px; }

  .idiom-footer__links a {
    color: rgba(26,26,26,0.75);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.15s;
  }

  .idiom-footer__links a:hover {
    color: var(--idiom-black, #1a1a1a);
    text-decoration: underline;
  }

  /* Bottom bar */
  .idiom-footer__bottom {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0 16px;
    border-top: 1px solid rgba(26,26,26,0.12);
    margin-top: 0;
  }

  .idiom-footer__copyright {
    color: rgba(26,26,26,0.45);
    font-size: 11px;
  }

  /* Tablet */
  @media (max-width: 768px) {
    .idiom-footer {
      padding: 40px 24px 0;
    }

    .idiom-footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .idiom-footer__col--brand {
      grid-column: span 2;
      padding-right: 0;
    }

    .idiom-footer__logotype-img {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
    }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .idiom-footer {
      padding: 32px 16px 0;
    }

    .idiom-footer__columns {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .idiom-footer__col--brand {
      grid-column: span 1;
    }

    .idiom-footer__logotype-img {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
    }
  }
</style>

<footer class="idiom-footer">

