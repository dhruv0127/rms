<style>
  .idiom-trust-bar {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-top: 1px solid rgba(26,26,26,0.15);
    border-bottom: 1px solid rgba(26,26,26,0.15);
    background: var(--idiom-cream, #faf6f0);
  }

  .idiom-trust-bar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px 16px;
    font-family: "farro-bold (2)", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--idiom-black, #1a1a1a);
    text-align: center;
    border-right: 1px solid rgba(26,26,26,0.15);
    line-height: 1.1;
  }

  .idiom-trust-bar__item:last-child {
    border-right: none;
  }

  /* Mobile marquee */
  .idiom-trust-bar--marquee {
    display: none;
  }

  @media (max-width: 480px) {
    .idiom-trust-bar {
      display: none;
    }

    .idiom-trust-bar--marquee {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      border-top: 1px solid rgba(26,26,26,0.15);
      border-bottom: 1px solid rgba(26,26,26,0.15);
      background: var(--idiom-cream, #faf6f0);
    }

    .idiom-trust-bar--marquee__track {
      display: inline-flex;
      animation: trust-bar-marquee 18s linear infinite;
    }

    .idiom-trust-bar--marquee__item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 24px;
      font-family: "farro-bold (2)", sans-serif;
      font-size: 13px;
      font-weight: 400;
      color: var(--idiom-black, #1a1a1a);
      white-space: nowrap;
    }

    .idiom-trust-bar--marquee__item::after {
      content: '·';
      opacity: 0.4;
    }

    @keyframes trust-bar-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  }
</style>

<div class="idiom-trust-bar">
  {%- for block in section.blocks -%}
    <div class="idiom-trust-bar__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
  {%- endfor -%}
</div>

<div class="idiom-trust-bar--marquee" aria-hidden="true">
  <div class="idiom-trust-bar--marquee__track">
    {%- for block in section.blocks -%}
      <span class="idiom-trust-bar--marquee__item">{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <span class="idiom-trust-bar--marquee__item">{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "free samples in every order" }
      ]
    }
  ],
  "presets": [{ "name": "Trust Bar" }]
}
{% endschema %}
