{{ 'idiom-theme.css' | asset_url | stylesheet_tag }}

<section class="idiom-brand-story">
  {%- if section.settings.collage_image != blank -%}
    <div class="idiom-brand-story__collage" aria-hidden="true">
      {{
        section.settings.collage_image
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          class: 'idiom-brand-story__collage-img',
          widths: '400, 600, 900',
          sizes: '40vw'
      }}
    </div>
  {%- endif -%}

  <div class="idiom-brand-story__content-wrap">
    <div class="idiom-brand-story__text-block">
      {%- if section.settings.heading != blank -%}
        <h2 class="idiom-brand-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subline != blank -%}
        <p class="idiom-brand-story__subline">{{ section.settings.subline }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="idiom-brand-story__body">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="idiom-btn idiom-brand-story__cta"
          href="{{ section.settings.cta_url | default: '#' }}"
        >
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="idiom-brand-story__grid-transition">
      {%- if section.settings.grid_heading != blank -%}
        <h3 class="idiom-brand-story__grid-heading">{{ section.settings.grid_heading }}</h3>
      {%- endif -%}

      {%- if section.settings.grid_subtext != blank -%}
        <p class="idiom-brand-story__grid-subtext">{{ section.settings.grid_subtext }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .idiom-brand-story {
    position: relative;
    background: var(--idiom-cream);
    width: 100%;
    padding: 80px 48px 80px 48px;
    overflow: hidden;
  }

  /* ---- Left decorative collage ---- */
  .idiom-brand-story__collage {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 40%;
    max-height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .idiom-brand-story__collage-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ---- Content wrap (sits on top of absolute collage) ---- */
  .idiom-brand-story__content-wrap {
    position: relative;
    z-index: 1;
    margin-left: 42%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ---- Text block ---- */
  .idiom-brand-story__text-block {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .idiom-brand-story__heading {
    font-size: 36px;
    font-weight: 700;
    color: var(--idiom-black);
    line-height: 1.2;
    margin: 0;
  }

  .idiom-brand-story__subline {
    font-size: 20px;
    font-style: italic;
    color: var(--idiom-black);
    opacity: 0.75;
    margin: 0;
  }

  .idiom-brand-story__body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--idiom-black);
    opacity: 0.85;
    margin: 0;
  }

  .idiom-brand-story__cta {
    margin-top: 8px;
    align-self: flex-start;
  }

  /* ---- Grid transition ---- */
  .idiom-brand-story__grid-transition {
    margin-top: 72px;
    width: 100%;
    text-align: center;
    padding-bottom: 8px;
  }

  .idiom-brand-story__grid-heading {
    font-size: 32px;
    font-weight: 700;
    color: var(--idiom-black);
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .idiom-brand-story__grid-subtext {
    font-size: 14px;
    font-weight: 400;
    color: var(--idiom-black);
    opacity: 0.65;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* ---- Tablet ---- */
  @media (max-width: 768px) {
    .idiom-brand-story {
      padding: 60px 32px;
    }

    .idiom-brand-story__collage {
      width: 50%;
      opacity: 0.25;
    }

    .idiom-brand-story__content-wrap {
      margin-left: 0;
      align-items: center;
    }

    .idiom-brand-story__text-block {
      max-width: 100%;
      text-align: center;
    }

    .idiom-brand-story__cta {
      align-self: center;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 480px) {
    .idiom-brand-story {
      padding: 40px 16px;
    }

    /* Hide the absolute collage; show stacked version instead */
    .idiom-brand-story__collage {
      display: none;
    }

    .idiom-brand-story__content-wrap {
      margin-left: 0;
      align-items: center;
    }

    .idiom-brand-story__text-block {
      max-width: 100%;
      width: 100%;
      text-align: center;
      padding: 0;
    }

    .idiom-brand-story__heading {
      font-size: 28px;
    }

    .idiom-brand-story__subline {
      font-size: 17px;
    }

    .idiom-brand-story__cta {
      align-self: center;
    }

    .idiom-brand-story__grid-transition {
      margin-top: 48px;
    }

    .idiom-brand-story__grid-heading {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "idiom-brand-story-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "collage_image",
      "label": "Left decorative collage image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "sick of smelling like everyone else?"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "yeah, us too."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "idiom was born by 3 good friends who shared a passion for fragrance with the belief that individuality is everything and fragrance could be done better, high-quality, long lasting capsule eau du parfums ready to layer and always priced to be affordable."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "learn more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid transition heading",
      "default": "holy s#*%, what are you wearing?"
    },
    {
      "type": "text",
      "id": "grid_subtext",
      "label": "Grid transition subtext",
      "default": "get to know our crowd-pleasers..."
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
