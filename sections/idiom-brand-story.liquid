{{ 'idiom-theme.css' | asset_url | stylesheet_tag }}

<style>
  .idiom-brand-story-section {
    overflow: visible;
    padding: 0 20px;
    position: relative;
    z-index: 10;
  }

  .idiom-brand-story {
    position: relative;
    background: #8b8b2a;
    width: 100%;
    padding: 0 0 72px;
    overflow: hidden;
    text-align: center;
    border-radius: 28px;
  }

  /* Butterfly — top-left, large, mostly off the top edge */
  .idiom-brand-story__butterfly {
    position: absolute;
    top: -60px;
    left: -20px;
    width: 380px;
    pointer-events: none;
    z-index: 1;
  }

  .idiom-brand-story__butterfly img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Moon — bottom-right, about 45% hanging below the section */
  .idiom-brand-story__moon {
    position: absolute;
    bottom: -90px;
    right: 0;
    pointer-events: none;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
  }

  .idiom-brand-story__moon img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0;
    max-width: 260px;
    right: 0;
  }

  /* Main content — centered, on top of decorative elements */
  .idiom-brand-story__content {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .idiom-brand-story__heading {
    font-size: 42px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .idiom-brand-story__subline {
    font-size: 18px;
    font-style: italic;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }

  .idiom-brand-story__body {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255,255,255,0.8);
    margin: 0;
    max-width: 520px;
  }

  .idiom-brand-story__cta {
    display: inline-block;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 14px 0;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    margin-top: 8px;
    width: 360px;
    max-width: 100%;
    text-align: center;
    transition: background 0.2s;
  }

  .idiom-brand-story__cta:hover {
    background: #333333;
  }

  /* ── Marquee strip — top of olive block ── */
  .idiom-brand-story__marquee-strip {
    background: #6e6e22;
    padding: 10px 0;
    overflow: hidden;
    white-space: nowrap;
    margin-bottom: 56px;
  }

  .idiom-brand-story__marquee-strip .idiom-marquee-track {
    font-family: "farro-bold (2)", sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(255,255,255,0.75);
    letter-spacing: 0.06em;
    text-transform: lowercase;
    gap: 0;
  }

  .idiom-brand-story__marquee-strip .idiom-marquee-track span {
    padding: 0 20px;
  }

  /* Grid transition — cream bg, centered, below the olive block */
  .idiom-brand-story__grid-transition {
    background: var(--idiom-cream);
    text-align: center;
    padding: 60px 48px 32px;
  }

  .idiom-brand-story__grid-heading {
    font-size: 36px;
    font-weight: 800;
    color: var(--idiom-black);
    margin: 0 0 10px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .idiom-brand-story__grid-subtext {
    font-size: 14px;
    color: var(--idiom-black);
    opacity: 0.55;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Tablet */
  @media (max-width: 768px) {
    .idiom-brand-story-section {
      padding: 0 12px;
    }

    .idiom-brand-story {
      padding: 0 0 60px;
    }

    .idiom-brand-story__content {
      padding: 0 28px;
    }

    .idiom-brand-story__butterfly {
      width: 260px;
      top: -40px;
      left: -10px;
    }

    .idiom-brand-story__moon {
      width: 260px;
      bottom: -120px;
      right: -10px;
    }

    .idiom-brand-story__heading {
      font-size: 32px;
    }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .idiom-brand-story-section {
      padding: 16px 8px 0;
    }

    .idiom-brand-story {
      padding: 0 0 24px;
      border-radius: 16px;
    }

    .idiom-brand-story__marquee-strip {
      margin-bottom: 16px;
    }

    .idiom-brand-story__butterfly {
      width: 180px;
      top: -30px;
      left: -10px;
      display: none;
    }

    .idiom-brand-story__moon {
      display: none;
    }

    .idiom-brand-story__heading {
      font-size: 16px;
    }

    .idiom-brand-story__content {
      padding: 0 20px;
    }

    .idiom-brand-story__cta {
      width: 100%;
      min-height: 44px;
      line-height: 44px;
      padding-top: 0;
      padding-bottom: 0;
      font-size: 12px;
    }

    .idiom-brand-story__grid-transition {
      padding: 20px 16px 8px;
    }

    .idiom-brand-story__grid-heading {
      font-size: 16px;
    }

    .idiom-brand-story__subline,
    .idiom-brand-story__body,
    .idiom-brand-story__grid-subtext,
    .idiom-brand-story__marquee-strip .idiom-marquee-track {
      font-size: 12px;
    }
  }
</style>

<div class="idiom-brand-story">
  {%- assign marquee_items = section.settings.marquee_text | default: "smell like no one else™ · find your fragrance freedom · layer, or wear solo · " -%}
  <div class="idiom-brand-story__marquee-strip">
    <div class="idiom-marquee-track" aria-hidden="true">
      {%- for i in (1..6) -%}
        <span>{{ marquee_items }}</span>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.butterfly_image != blank -%}
    <div class="idiom-brand-story__butterfly" aria-hidden="true">
      <img src="{{ section.settings.butterfly_image | image_url: width: 700 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}

  {%- if section.settings.moon_image != blank -%}
    <div class="idiom-brand-story__moon" aria-hidden="true">
      <img src="{{ section.settings.moon_image | image_url: width: 600 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}

  <div class="idiom-brand-story__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="idiom-brand-story__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subline != blank -%}
      <p class="idiom-brand-story__subline">{{ section.settings.subline }}</p>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="idiom-brand-story__body">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="idiom-brand-story__cta" href="{{ section.settings.cta_url | default: '#' }}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.grid_heading != blank or section.settings.grid_subtext != blank -%}
  <div class="idiom-brand-story__grid-transition">
    {%- if section.settings.grid_heading != blank -%}
      <h3 class="idiom-brand-story__grid-heading">{{ section.settings.grid_heading }}</h3>
    {%- endif -%}
    {%- if section.settings.grid_subtext != blank -%}
      <p class="idiom-brand-story__grid-subtext">{{ section.settings.grid_subtext }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "idiom-brand-story-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "butterfly_image",
      "label": "Left decorative image (butterfly)"
    },
    {
      "type": "image_picker",
      "id": "moon_image",
      "label": "Right decorative image (moon)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "sick of smelling like everyone else?"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "yeah, us too."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "idiom was born by 3 good friends who shared a passion for fragrance with the belief that individuality is everything and fragrance could be done better, high-quality, long lasting capsule eau du parfums ready to layer and always priced to be affordable."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "learn more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "smell like no one else™ · find your fragrance freedom · layer, or wear solo · "
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid transition heading",
      "default": "holy s#*%, what are you wearing?"
    },
    {
      "type": "text",
      "id": "grid_subtext",
      "label": "Grid transition subtext",
      "default": "get to know our crowd-pleasers..."
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
